{
  "name": "proofed-cli",
  "version": "0.1.1",
  "description": "Check web app scenarios in Chrome with Kane CLI before you call a change done.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t1dem/proofed.git"
  },
  "homepage": "https://github.com/t1dem/proofed#readme",
  "bugs": {
    "url": "https://github.com/t1dem/proofed/issues"
  },
  "keywords": [
    "cli",
    "browser",
    "testing",
    "chrome",
    "kane"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "proofed": "bin/proofed.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });' && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "check:package": "node scripts/check-package.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run check:package"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.20.0",
  "files": [
    "bin/*.cjs",
    "dist/*.js",
    "README.md"
  ]
}
