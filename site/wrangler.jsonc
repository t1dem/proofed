{
  "name": "proofed",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "account_id": "c0f143c145a53cbc87a3a7709d6dfb26",
  "assets": {
    "not_found_handling": "single-page-application",
